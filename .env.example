# Copy to .env and fill in. .env is git-ignored.

# --- Google OAuth (app login) ---
# Create an OAuth client (type: Web application) at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI:  http://localhost:5173/auth/google/callback
# Leave both empty to run without login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_ORIGIN=http://localhost:5173

# Signs the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- Claude analysis ---
# Server-side only; never sent to the browser. Leave empty to use local estimates only.
ANTHROPIC_API_KEY=
# Set to 1 instead if you authenticate with `ant auth login` rather than an API key.
ANALYSIS_FORCE_ENABLE=
ANALYSIS_MODEL=claude-opus-5-5
# low | medium | high — higher is slower but more careful.
ANALYSIS_EFFORT=low
# low | medium | high for the whole-essay Score evaluation.
EVAL_EFFORT=medium
